let $LFC /fusion-test/case/inputs/with_node_included.tsv
let $UP 0.9
let $DOWN -0.9
let $MERGED_GRAPH /fusion-test/case/inputs/report_example_with_pathways.xml
let $SPLIT_THRESHOLD 1
let $SOURCE hsa1
let $TARGET hsa22
let $BOUND 10
let $EDGES_TO_TARGET any
let $FSC hsa13
let $NODE_MIN 0
let $NODE_MAX 7
let $EDGE_MIN 0
