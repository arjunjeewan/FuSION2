# embed_asset.cmake: writes OUTPUT, a C++ source that holds INPUT's bytes, size and SHA-256 under the
# names fusion::results::asset_data::SYMBOL, SYMBOL_size and SYMBOL_sha256 (11.C11). Run at build time:
#   cmake -DINPUT=<file> -DOUTPUT=<file.cpp> -DSYMBOL=<identifier> -P embed_asset.cmake
foreach(_var INPUT OUTPUT SYMBOL)
  if(NOT DEFINED ${_var})
    message(FATAL_ERROR "embed_asset.cmake needs -D${_var}=...")
  endif()
endforeach()

file(READ "${INPUT}" _hex HEX)
file(SHA256 "${INPUT}" _sha256)
file(SIZE "${INPUT}" _size)
if(_size EQUAL 0)
  set(_body "0x00")                     # an empty file still needs one element; the size says 0
else()
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _body "${_hex}")
  string(REPEAT "0x[0-9a-f][0-9a-f]," 24 _line)   # CMake's regex has no {n}: 24 bytes per line
  string(REGEX REPLACE "(${_line})" "\\1\n" _body "${_body}")
endif()

file(WRITE "${OUTPUT}.tmp"
"// Generated by embed_asset.cmake from ${SYMBOL}'s source file; do not edit (11.C11).\n"
"#include <cstddef>\n"
"namespace fusion::results::asset_data {\n"
"extern const unsigned char ${SYMBOL}[];\n"
"extern const std::size_t ${SYMBOL}_size;\n"
"extern const char ${SYMBOL}_sha256[];\n"
"const unsigned char ${SYMBOL}[] = {\n${_body}\n};\n"
"const std::size_t ${SYMBOL}_size = ${_size};\n"
"const char ${SYMBOL}_sha256[] = \"${_sha256}\";\n"
"}  // namespace fusion::results::asset_data\n")
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
